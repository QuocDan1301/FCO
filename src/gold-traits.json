{
 "note": "Chỉ số ẩn vàng theo mã cầu thủ (mỗi mã một mùa thẻ), nguồn vn.fifaaddict.com (trait_gold), thu thập 2026-11-15. Thẻ không có trong cards = không có chỉ số ẩn vàng hoặc chưa có dữ liệu.",
 "names": {
  "50": "Chuyên gia vô lê",
  "51": "Sát thủ băng cắt",
  "52": "Bậc thầy chạy chỗ",
  "53": "Cao thủ tắc bóng",
  "54": "Chuyên gia đeo bám",
  "55": "Người không phổi",
  "56": "Chặn đà tấn công",
  "57": "Phản ứng nhanh (GK)",
  "59": "Nhạc trưởng",
  "60": "GK áp đảo không chiến",
  "62": "Chủ Động Cản Phá",
  "63": "Siêu Bứt Tốc",
  "64": "Bậc thầy không chiến",
  "65": "Ảo thuật gia",
  "66": "Dứt điểm 1 chạm",
  "67": "Siêu đánh chặn",
  "68": "GK Bắt bài Sút xa"
 },
 "desc": {
  "50": "Thường xuyên tung ra các cú vô lê với tư thế ngả người móc bóng",
  "51": "Di chuyển nhanh đến điểm rơi trong các tình huống tạt bóng.",
  "52": "Di chuyển không bóng thông minh để phá vỡ hàng phòng ngự của đối thủ",
  "53": "Tăng phạm vi thực hiện pha tắc bóng đúng, kể cả từ phía sau đối thủ",
  "54": "Bám đuổi cầu thủ đối phương nhanh hơn khi họ phản công.",
  "55": "Khi tăng tốc, thể lực tiêu hao ít hơn và việc giảm chỉ số do cạn thể lực cũng ít hơn.",
  "56": "Khi thực hiện tranh chấp sẽ làm giảm tốc độ bứt tốc và độ chính xác cú sút của đối phương",
  "57": "Khi gọi thủ môn lao lên, thủ môn sẽ di chuyển nhanh hơn.",
  "59": "Sử dụng đường chuyền chọc khe bổng thấp và nhanh có hiệu ứng xoáy ngược.",
  "60": "Phòng ngự các pha tạt bóng một cách ổn định bằng cách chọn vị trí nhanh và thông minh trong các tình huống tạt bóng.",
  "62": "Bay người cản phá cú sút.",
  "63": "Tăng tốc và đột phá vào khoảng trống trong khi rê bóng.",
  "64": "Cản trở cầu thủ đối phương trong các tình huống tranh chấp bóng bổng để giành vị trí thuận lợi.",
  "65": "Sử dụng các kỹ năng cá nhân đa dạng để đánh lừa đối phương.",
  "66": "Thực hiện cú sút trực tiếp với quỹ đạo thấp và nhanh khi bóng đang bay thẳng tới.",
  "67": "Duy trì khoảng cách với đối thủ để chặn các tình huống đột phá bằng rê bóng.",
  "68": "Chọn vị trí bằng cách dự đoán các cú sút xa của đối thủ."
 },
